@model Avancerad_programmering_ASP.NET_Labb1_pokemonMVC.Models.Pokemon;


<h1>Results</h1>

@if (Model == null)
{
    <h1>No pokemon found</h1>
}
else
{

    <p><img src="@Model.sprites.other.officialartwork.frontshiny" /></p>
    <p>Name: @Model.Name</p>
    <p>Id: @Model.id</p>
    <p>Weight: @Model.Weight</p>
    <p>
        Moves:@foreach (var move in Model.Moves)
        {
            <p>@move.move.Name</p>
        }
    </p>

}

<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go back</a>