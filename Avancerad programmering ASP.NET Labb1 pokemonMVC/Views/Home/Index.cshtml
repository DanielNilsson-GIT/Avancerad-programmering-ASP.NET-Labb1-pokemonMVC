@model List<Avancerad_programmering_ASP.NET_Labb1_pokemonMVC.Models.Pokemon>;
@{
    ViewData["Title"] = "Home Page";
}
<div class="text-center">
    <h1 class="display-4">Welcome! Please search after a pokémon, or find it in the list below</h1>
    <form asp-action="Search" asp-controller="Home">
        <input type="text" name="name" />
        <button type="submit">Search</button>
    </form>

    @foreach(var pokemon in Model)
    {
        <a asp-action="Search" asp-controller="Home" asp-route-name="@pokemon.Name">
        @pokemon.Name
        </a>
            <br />
        
    }
    <button>Show next 20</button>

</div>


